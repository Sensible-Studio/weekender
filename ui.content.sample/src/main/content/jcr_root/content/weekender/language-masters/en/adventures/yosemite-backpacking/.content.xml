                                    jcr:lastModifiedBy="admin"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Granite, pines and a long way from the car park"
                                    sling:resourceType="weekender/components/image"
                                    altValueFromDAM="true"
                                    displayPopupTitle="false"
                                    fileReference="/content/dam/weekender-shared/en/adventures/yosemite-backpacking/yosemite-backpacking-1.jpg"
