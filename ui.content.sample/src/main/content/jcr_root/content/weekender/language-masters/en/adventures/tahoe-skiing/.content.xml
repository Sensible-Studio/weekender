                        <item_1594238312974
                            cq:panelTitle="Overview"
                            jcr:lastModified="{Date}2020-11-08T12:10:55.887-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/tahoe-skiing/tahoe-skiing"
                            paragraphScope="all"
                            text="Tahoe Skiing Lake Tahoe sits at 1,900 metres on the border of California and Nevada, ringed by more than a dozen ski areas. The snow falls in great quantities and the sun comes out soon afterwards. We ski a different mountain each day and stay in one lodge on the north shore, so there is no packing and unpacking. The trip is for strong skiers and snowboarders who like variety."
                            variationName="master">
                            <par1
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid"/>
                            <par0
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/components/grid">
                                <image
                                    jcr:created="{Date}2020-11-08T12:12:07.980-08:00"
                                    jcr:createdBy="admin"
                                    jcr:lastModified="{Date}2020-11-08T12:12:17.237-08:00"
                                    jcr:lastModifiedBy="admin"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="weekender/components/image"
                                    altValueFromDAM="true"
                                    displayPopupTitle="false"
                                    fileReference="/content/dam/weekender-shared/en/adventures/tahoe-skiing/tahoe-skiing-2.jpg"
                                    isDecorative="false"
                                    titleValueFromDAM="true"/>
                            </par0>
                        </item_1594238312974>
                        <item_1570890140330
                            cq:panelTitle="Itinerary"
                            jcr:lastModified="{Date}2020-11-08T12:11:16.554-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="itinerary"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/tahoe-skiing/tahoe-skiing"
                            paragraphScope="all"
                            text="Tahoe Skiing Day 1: The big mountain The largest area on the north shore, with wide bowls above the tree line and steep chutes for those who want them. A good day to find your legs. Day 2: The view A drive along the lake to the south shore, where the runs seem to drop straight into blue water on one side and the Nevada desert on the other. Long, fast cruising runs, and lunch on a terrace in the sun. Days 3 and 4: The locals' hills Two smaller areas that visitors overlook: fewer people, trees to ski between after a snowfall, and a bar where the lift crew drinks. The fourth day is optional."
                            variationName="master">
                            <par6
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid"/>
                        </item_1570890140330>
