                        <item_1570890135033
                            cq:panelTitle="Overview"
                            cq:styleIds="[1571166691078]"
                            jcr:lastModified="{Date}2020-07-08T15:33:34.874-07:00"
                            jcr:lastModifiedBy="admin"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/beervana-portland/beervana-in-portland"
                            paragraphScope="all"
                            text="Beervana in Portland A day among Portland's small breweries Portland has more breweries than any city of its size, most of them small, independent and within walking distance of each other. This is a day on foot between four of them, in the company of a guide who has brewed for a living. You will taste around a dozen beers in small glasses, see how they are made and eat well along the way. It is a day for the curious, and you do not need to know anything about beer to enjoy it."
                            variationName="master">
                            <par2
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="weekender/components/container">
                                <image
                                    jcr:created="{Date}2019-10-25T10:03:05.798-07:00"
