                        <item_1594238312974
                            cq:lastRolledout="{Date}2020-11-08T12:40:49.670-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Overview"
                            jcr:lastModified="{Date}2020-11-08T12:40:49.668-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/colorado-rock-climbing/colorado-rock-climbing"
                            paragraphScope="all"
                            text="Overnight Colorado Rock Climbing Colorado packs an unusual variety of rock into a small area: red sandstone, rough granite and smooth river-cut canyon walls, all within a day's drive. Over three days we climb on each of them and camp in between. The trip suits climbers who already lead outdoors and are comfortable on long days at altitude."
                            variationName="master">
                            <par1
                                cq:lastRolledout="{Date}2020-11-08T12:40:49.672-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid">
                                <image
