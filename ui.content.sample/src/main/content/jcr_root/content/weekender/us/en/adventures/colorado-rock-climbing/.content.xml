                        </item_1594238312974>
                        <item_1570890140330
                            cq:lastRolledout="{Date}2020-11-08T12:40:49.678-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Itinerary"
                            jcr:lastModified="{Date}2020-11-08T12:40:49.676-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="itinerary"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/colorado-rock-climbing/colorado-rock-climbing"
                            paragraphScope="all"
                            text="Overnight Colorado Rock Climbing Day 1: Sandstone We begin among the red fins at the foot of the Front Range. The rock is soft and the holds are rounded, so the morning is a lesson in trusting your feet. Camp is an hour into the hills. Day 2: Granite A full day on a granite dome with routes of three to five pitches. Cracks, slabs and a summit wide enough to eat lunch on. We keep an eye on the sky: storms arrive in the early afternoon in summer, and we plan to be down before them. Day 3: The canyon The last morning is spent on shaded walls above a creek, on short, steep routes that are a pleasure after two long days. We finish with a late lunch in town."
                            variationName="master">
                            <par6
                                cq:lastRolledout="{Date}2020-11-08T12:40:49.680-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid"/>
                        </item_1570890140330>
