                        <item_1570890140330
                            cq:lastRolledout="{Date}2020-11-08T12:40:50.533-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Itinerary"
                            jcr:lastModified="{Date}2020-11-08T12:40:50.530-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="itinerary"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/yosemite-backpacking/yosemite-backpacking"
                            paragraphScope="all"
                            text="Yosemite Backpacking Day 1 We meet in the valley at nine to check packs and collect the wilderness permit, then take the bus up to the high road and walk three hours to the first lake. Day 2 Over a pass with a view of the whole range, and down to a camp in a meadow beside a stream. Day 3 A day without the big packs: a scramble up a granite dome in the morning, a swim and a rest in the afternoon. Day 4 A long descent through forest toward the rim of the valley. The last camp looks straight across at the great cliffs. Day 5 Down the trail beside two waterfalls, wet with spray, to the valley floor and a well-earned lunch."
                            variationName="master">
                            <par10
                                cq:lastRolledout="{Date}2020-11-08T12:40:50.535-08:00"
                                cq:lastRolledoutBy="admin"
