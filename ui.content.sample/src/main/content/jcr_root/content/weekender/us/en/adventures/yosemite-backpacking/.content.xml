                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/yosemite-backpacking/yosemite-backpacking"
                            paragraphScope="all"
                            text="Yosemite Backpacking Most visitors to Yosemite see the valley floor, and it deserves its fame. The larger part of the park lies above it: open granite, meadows, and lakes that few people reach, because the only way in is on foot. We carry what we need for four nights and walk between 10 and 16 kilometres a day. You need to be fit and used to walking with a pack; no earlier backpacking experience is required."
                            variationName="master">
                            <par1
                                cq:lastRolledout="{Date}2020-11-08T12:40:50.522-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
