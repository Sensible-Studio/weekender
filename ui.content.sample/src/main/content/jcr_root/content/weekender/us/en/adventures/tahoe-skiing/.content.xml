                        <item_1570890140330
                            cq:lastRolledout="{Date}2020-11-08T12:40:50.359-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Itinerary"
                            jcr:lastModified="{Date}2020-11-08T12:40:50.357-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="itinerary"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/tahoe-skiing/tahoe-skiing"
                            paragraphScope="all"
                            text="Tahoe Skiing Day 1: The big mountain The largest area on the north shore, with wide bowls above the tree line and steep chutes for those who want them. A good day to find your legs. Day 2: The view A drive along the lake to the south shore, where the runs seem to drop straight into blue water on one side and the Nevada desert on the other. Long, fast cruising runs, and lunch on a terrace in the sun. Days 3 and 4: The locals' hills Two smaller areas that visitors overlook: fewer people, trees to ski between after a snowfall, and a bar where the lift crew drinks. The fourth day is optional."
                            variationName="master">
                            <par6
                                cq:lastRolledout="{Date}2020-11-08T12:40:50.361-08:00"
                                cq:lastRolledoutBy="admin"
