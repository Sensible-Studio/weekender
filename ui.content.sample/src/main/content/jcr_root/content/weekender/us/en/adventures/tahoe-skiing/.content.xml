                            cq:panelTitle="Overview"
                            jcr:lastModified="{Date}2020-11-08T12:40:50.344-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/tahoe-skiing/tahoe-skiing"
                            paragraphScope="all"
                            text="Tahoe Skiing Lake Tahoe sits at 1,900 metres on the border of California and Nevada, ringed by more than a dozen ski areas. The snow falls in great quantities and the sun comes out soon afterwards. We ski a different mountain each day and stay in one lodge on the north shore, so there is no packing and unpacking. The trip is for strong skiers and snowboarders who like variety."
                            variationName="master">
                            <par1
                                cq:lastRolledout="{Date}2020-11-08T12:40:50.351-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid"/>
                            <par0
