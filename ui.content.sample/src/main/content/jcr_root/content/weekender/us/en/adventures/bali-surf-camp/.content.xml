                        <item_1594238312974
                            cq:lastRolledout="{Date}2020-11-08T12:40:49.478-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Overview"
                            jcr:lastModified="{Date}2020-11-08T12:40:49.475-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/bali-surf-camp/bali-surf-camp"
                            paragraphScope="all"
                            text="Bali Surf Camp Bali has a wave for everyone: soft rollers over sand for a first week on a board, and long reef breaks for people who have surfed for years. We stay in a small guesthouse a short walk from the beach, surf twice a day and leave the hot middle of the day for sleep, food and a swim. The camp is planned for beginners and improvers. Each morning the coaches look at the swell and the tide and pick the break that fits the group that day."
                            variationName="master">
                            <par1
                                cq:lastRolledout="{Date}2020-11-08T12:40:49.480-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid">
                                <image
                                    cq:lastRolledout="{Date}2020-11-08T12:40:49.484-08:00"
                                    cq:lastRolledoutBy="admin"
