                                    jcr:createdBy="admin"
                                    jcr:lastModified="{Date}2020-11-08T12:40:49.482-08:00"
                                    jcr:lastModifiedBy="admin"
                                    jcr:mixinTypes="[cq:LiveRelationship]"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="weekender/components/image"
                                    fileReference="/content/dam/weekender-shared/en/adventures/surf-camp-in-costa-rica/surf-camp-in-costa-rica-3.jpg"/>
                            </par1>
                        </item_1594238312974>
                        <item_1570890140330
                            cq:lastRolledout="{Date}2020-11-08T12:40:49.488-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Itinerary"
                            jcr:lastModified="{Date}2020-11-08T12:40:49.486-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="itinerary"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/bali-surf-camp/bali-surf-camp"
                            paragraphScope="all"
                            text="Bali Surf Camp Day 1: Arrival Transfer from the airport, a board fitted to your height and level, and a first paddle at sunset on the beach break in front of the house. Days 2 to 3: The beach breaks Two sessions a day on sand-bottom waves, one early and one late, with video review after lunch. By the third evening most people are standing up and turning. Days 4 to 5: The first reef A boat takes us to a gentle reef break on the peninsula, where the wave is longer and gives time to practise. One afternoon is free for a temple visit or a massage. Day 6: Last waves A dawn session at the break the group liked most, breakfast together and transfers to the airport."
                            variationName="master">
                            <par6
                                cq:lastRolledout="{Date}2020-11-08T12:40:49.490-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/responsivegrid"/>
                        </item_1570890140330>
