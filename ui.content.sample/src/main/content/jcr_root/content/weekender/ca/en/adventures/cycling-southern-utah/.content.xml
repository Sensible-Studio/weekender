                        <item_1570890140330
                            cq:lastRolledout="{Date}2020-11-08T12:40:48.351-08:00"
                            cq:lastRolledoutBy="admin"
                            cq:panelTitle="Itinerary"
                            jcr:lastModified="{Date}2020-11-08T12:40:48.349-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="itinerary"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/cycling-southern-utah/cycling-southern-utah"
                            paragraphScope="all"
                            text="Cycling Southern Utah Day 1: Into the canyons A two-hour transfer from the airport to the lodge, bike fitting and a short ride at the end of the afternoon to loosen the legs. Dinner and a briefing on the days ahead. Days 2 to 4: Three stages Each day follows the same pattern: an early start while it is cool, a long climb to a plateau, lunch from the van at a viewpoint and a descent to the next lodge. Day three is the hardest, with 1,800 metres of climbing, and ends at a rim where the sunset is worth the effort. On day four there is time for a walk among the rock formations on foot. Day 5: The last descent A morning ride of 60 kilometres, mostly downhill, lunch together and transfers back to the airport."
                            variationName="master">
                            <par6
                                cq:lastRolledout="{Date}2020-11-08T12:40:48.353-08:00"
                                cq:lastRolledoutBy="admin"
                                jcr:mixinTypes="[cq:LiveRelationship]"
