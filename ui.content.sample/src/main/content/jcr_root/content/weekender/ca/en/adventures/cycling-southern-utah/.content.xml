                            cq:panelTitle="Overview"
                            jcr:lastModified="{Date}2020-11-08T12:40:48.339-08:00"
                            jcr:lastModifiedBy="admin"
                            jcr:mixinTypes="[cq:LiveRelationship]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="weekender/components/contentfragment"
                            displayMode="singleText"
                            elementNames="description"
                            fragmentPath="/content/dam/weekender-shared/en/adventures/cycling-southern-utah/cycling-southern-utah"
                            paragraphScope="all"
                            text="Cycling Southern Utah Southern Utah is a landscape of red cliffs, natural arches and roads with almost no traffic. We cross it by road bike over five days, riding between 60 and 110 kilometres a day with a support van that carries the bags, the water and anyone who has had enough. The climbs are long and the air is thin and dry, so this is a trip for fit, experienced riders."
                            variationName="master">
                            <par1
                                cq:lastRolledout="{Date}2020-11-08T12:40:48.343-08:00"
