            <master
                jcr:mixinTypes="[cq:Taggable,dam:cfVariationNode]"
                jcr:primaryType="nt:unstructured"
                activity="Skiing"
                activity_x0040_LastModified="{Date}2020-10-15T11:59:54.068-07:00"
                adventureType="Overnight Trip"
                adventureType_x0040_LastModified="{Date}2020-10-15T11:59:54.067-07:00"
                description="&lt;h2>A long weekend in the Tetons&lt;/h2>&#xa;&lt;p>The mountains of western Wyoming rise straight from a flat valley floor, and the ski area on their flank is known for two things: light, dry snow and a great deal of steep ground. With a local guide you spend less time reading the map and more time skiing. This trip suits confident skiers who are at home on red and black runs.&lt;/p>"
                description_x0040_ContentType="text/html"
                description_x0040_LastModified="{Date}2020-10-15T11:59:54.067-07:00"
                difficulty="Intermediate"
                difficulty_x0040_LastModified="{Date}2020-10-15T11:59:54.069-07:00"
                gearList="&lt;p>Skis, boots and poles can be hired on the spot at a group rate; say so when you book.&lt;/p>&#xa;&lt;ul>&#xa;&lt;li>Waterproof jacket and trousers&lt;/li>&#xa;&lt;li>Warm base and mid layers&lt;/li>&#xa;&lt;li>Helmet and goggles&lt;/li>&#xa;&lt;li>Two pairs of gloves&lt;/li>&#xa;&lt;li>A neck warmer: mornings at the top are very cold&lt;/li>&#xa;&lt;li>Sunscreen and lip balm&lt;/li>&#xa;&lt;/ul>&#xa;&lt;p>Lift passes are included in the price.&lt;/p>"
                gearList_x0040_ContentType="text/html"
                gearList_x0040_LastModified="{Date}2020-10-15T11:59:54.070-07:00"
                groupSize="{Long}4"
                groupSize_x0040_LastModified="{Date}2022-05-27T14:49:51.514-07:00"
                itinerary="&lt;h2>Day 1: The lie of the land&lt;/h2>&#xa;&lt;p>We meet at the base at half past eight and ride the cable car to the top, 1,200 metres above the valley. The morning is a tour of the mountain on groomed runs; in the afternoon the guide takes the group into the bowls and the trees, according to the snow.&lt;/p>&#xa;&lt;h2>&lt;b>Day 2: Steeper and deeper&lt;/b>&lt;/h2>&#xa;&lt;p>With the legs warmed up we go looking for the runs the area is famous for. There is always an easier way down, and nobody is asked to ski anything they do not like the look of. In the evening we eat in the old town, under the arches of antlers on the square.&lt;/p>&#xa;&lt;h2>&lt;b>Day 3 (optional): The quiet side&lt;/b>&lt;/h2>&#xa;&lt;p>A day at a smaller resort on the far side of the pass, where the snow is often deeper and the lift queues do not exist.&lt;/p>"
                itinerary_x0040_ContentType="text/html"
                itinerary_x0040_LastModified="{Date}2020-10-15T11:59:54.070-07:00"
