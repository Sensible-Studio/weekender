            <master
                jcr:mixinTypes="[cq:Taggable,dam:cfVariationNode]"
                jcr:primaryType="nt:unstructured"
                activity="Surfing"
                activity_x0040_LastModified="{Date}2020-10-20T14:49:04.760-07:00"
                adventureType="Overnight Trip"
                adventureType_x0040_LastModified="{Date}2020-10-20T14:49:04.759-07:00"
                description="&lt;p>Bali has a wave for everyone: soft rollers over sand for a first week on a board, and long reef breaks for people who have surfed for years. We stay in a small guesthouse a short walk from the beach, surf twice a day and leave the hot middle of the day for sleep, food and a swim.&lt;/p>&#xa;&lt;p>The camp is planned for beginners and improvers. Each morning the coaches look at the swell and the tide and pick the break that fits the group that day.&lt;/p>"
                description_x0040_ContentType="text/html"
                description_x0040_LastModified="{Date}2022-06-02T11:19:40.946-07:00"
                difficulty="Beginner"
                difficulty_x0040_LastModified="{Date}2020-10-20T14:49:04.761-07:00"
                gearList="&lt;ul>&#xa;&lt;li>Swimwear and a long-sleeved rash vest&lt;/li>&#xa;&lt;li>Reef-safe sunscreen and a hat&lt;/li>&#xa;&lt;li>Sandals and light clothes for the evening&lt;/li>&#xa;&lt;/ul>&#xa;&lt;p>Boards, leashes, wax and reef boots are provided.&lt;/p>"
                gearList_x0040_ContentType="text/html"
                gearList_x0040_LastModified="{Date}2020-10-20T14:49:04.762-07:00"
                groupSize="{Long}6"
                groupSize_x0040_LastModified="{Date}2022-05-27T14:50:03.550-07:00"
                itinerary="&lt;p>&lt;b>Day 1: Arrival&lt;/b>&lt;/p>&#xa;&lt;p>Transfer from the airport, a board fitted to your height and level, and a first paddle at sunset on the beach break in front of the house.&lt;/p>&#xa;&lt;p>&lt;b>Days 2 to 3: The beach breaks&lt;/b>&lt;/p>&#xa;&lt;p>Two sessions a day on sand-bottom waves, one early and one late, with video review after lunch. By the third evening most people are standing up and turning.&lt;/p>&#xa;&lt;p>&lt;b>Days 4 to 5: The first reef&lt;/b>&lt;/p>&#xa;&lt;p>A boat takes us to a gentle reef break on the peninsula, where the wave is longer and gives time to practise. One afternoon is free for a temple visit or a massage.&lt;/p>&#xa;&lt;p>&lt;b>Day 6: Last waves&lt;/b>&lt;/p>&#xa;&lt;p>A dawn session at the break the group liked most, breakfast together and transfers to the airport.&lt;/p>"
                itinerary_x0040_ContentType="text/html"
                itinerary_x0040_LastModified="{Date}2020-10-20T14:49:04.762-07:00"
