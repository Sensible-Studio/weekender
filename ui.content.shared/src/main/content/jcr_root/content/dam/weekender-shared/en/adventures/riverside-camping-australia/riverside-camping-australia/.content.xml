        <data
            cq:model="/conf/weekender-shared/settings/dam/cfm/models/adventure"
            jcr:primaryType="nt:unstructured">
            <master
                jcr:mixinTypes="[cq:Taggable,dam:cfVariationNode]"
                jcr:primaryType="nt:unstructured"
                activity="Camping"
                activity_x0040_LastModified="{Date}2020-10-15T11:58:51.056-07:00"
                adventureType="Overnight Trip"
                adventureType_x0040_LastModified="{Date}2020-10-15T11:58:51.055-07:00"
                description="&lt;p>Two hours inland from the coast the suburbs give way to gum forest, and a slow brown river winds through it between sandy banks. We camp beside it for two nights. There is nothing to achieve here: you can paddle, swim, walk, fish or sit under a tree with a book, and the cook will call when dinner is ready. It is a good first camping trip, and children are welcome.&lt;/p>"
                description_x0040_ContentType="text/html"
                description_x0040_LastModified="{Date}2020-10-15T11:58:51.055-07:00"
                difficulty="Beginner"
                difficulty_x0040_LastModified="{Date}2020-10-15T11:58:51.058-07:00"
                gearList="&lt;ul>&#xa;&lt;li>Clothes for warm days and cool nights, and a rain jacket&lt;/li>&#xa;&lt;li>Swimwear, a towel and shoes that can get wet&lt;/li>&#xa;&lt;li>Sun hat, sunscreen and insect repellent&lt;/li>&#xa;&lt;li>A torch and a water bottle&lt;/li>&#xa;&lt;/ul>&#xa;&lt;p>Tents, mattresses, sleeping bags, canoes and all meals are provided.&lt;/p>"
                gearList_x0040_ContentType="text/html"
                gearList_x0040_LastModified="{Date}2020-10-15T11:58:51.059-07:00"
                groupSize="{Long}6"
                groupSize_x0040_LastModified="{Date}2022-05-27T14:49:30.053-07:00"
                itinerary="&lt;p>&lt;b>Day 1: Out of the city&lt;/b>&lt;/p>&#xa;&lt;p>We meet at the country station at the end of the line, where the guides wait with a small bus. Half an hour on a dirt road brings us to the river.&lt;/p>&#xa;&lt;p>The tents are already up, each with real mattresses. After lunch there is a short lesson in handling a canoe, then free time on the water until the light turns gold. Dinner is cooked over the fire, and afterwards the guides point out the Southern Cross.&lt;/p>&#xa;&lt;p>&lt;b>Day 2: The river day&lt;/b>&lt;/p>&#xa;&lt;p>Kookaburras do the job of an alarm clock. After breakfast we paddle downstream for two easy hours to a sandy beach, with stops to look for platypus in the quiet pools; they are shy, and seeing one is luck.&lt;/p>&#xa;&lt;p>Lunch and a swim at the beach, then the bus carries people and canoes back to camp. In the late afternoon a ranger from the local community leads a walk and talks about the plants that her family has used here for generations.&lt;/p>&#xa;&lt;p>&lt;b>Day 3: A last morning&lt;/b>&lt;/p>&#xa;&lt;p>An early walk to a lookout over the valley for those who want it, a long breakfast for those who do not. We break camp together and are at the station for the midday train.&lt;/p>"
                itinerary_x0040_ContentType="text/html"
                itinerary_x0040_LastModified="{Date}2020-10-15T11:58:51.059-07:00"
                price="{Double}500.00"
                price_x0040_LastModified="{Date}2020-10-15T11:58:51.058-07:00"
                primaryImage="/content/dam/weekender-shared/en/adventures/riverside-camping-australia/riverside-camping-australia-6.jpg"
