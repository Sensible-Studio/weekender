            <master
                jcr:mixinTypes="[cq:Taggable,dam:cfVariationNode]"
                jcr:primaryType="nt:unstructured"
                activity="Camping"
                activity_x0040_LastModified="{Date}2020-11-05T13:18:58.025-08:00"
                adventureType="Overnight Trip"
                adventureType_x0040_LastModified="{Date}2020-11-05T13:18:58.023-08:00"
                description="&lt;p>Most visitors to Yosemite see the valley floor, and it deserves its fame. The larger part of the park lies above it: open granite, meadows, and lakes that few people reach, because the only way in is on foot. We carry what we need for four nights and walk between 10 and 16 kilometres a day. You need to be fit and used to walking with a pack; no earlier backpacking experience is required.&lt;/p>"
                description_x0040_ContentType="text/html"
                description_x0040_LastModified="{Date}2020-11-05T13:18:58.023-08:00"
                difficulty="Intermediate"
                difficulty_x0040_LastModified="{Date}2020-11-05T13:18:58.026-08:00"
                gearList="&lt;ul>&#xa;&lt;li>Walking boots that you have already worn in&lt;/li>&#xa;&lt;li>A rucksack of 50 to 60 litres&lt;/li>&#xa;&lt;li>Sleeping bag and mat&lt;/li>&#xa;&lt;li>Warm layer, rain jacket and a sun hat&lt;/li>&#xa;&lt;li>Shorts and long trousers&lt;/li>&#xa;&lt;li>Water bottles for three litres&lt;/li>&#xa;&lt;li>Head torch&lt;/li>&#xa;&lt;li>Sunscreen&lt;/li>&#xa;&lt;/ul>&#xa;&lt;p>Tents, stoves, food and the bear-proof canisters for storing it are provided.&lt;/p>"
                gearList_x0040_ContentType="text/html"
                gearList_x0040_LastModified="{Date}2020-11-05T13:18:58.028-08:00"
                groupSize="{Long}12"
                groupSize_x0040_LastModified="{Date}2022-05-27T14:51:47.405-07:00"
                itinerary="&lt;p>&lt;b>Day 1&lt;/b>&lt;/p>&#xa;&lt;p>We meet in the valley at nine to check packs and collect the wilderness permit, then take the bus up to the high road and walk three hours to the first lake.&lt;/p>&#xa;&lt;p>&lt;b>Day 2&lt;/b>&lt;/p>&#xa;&lt;p>Over a pass with a view of the whole range, and down to a camp in a meadow beside a stream.&lt;/p>&#xa;&lt;p>&lt;b>Day 3&lt;/b>&lt;/p>&#xa;&lt;p>A day without the big packs: a scramble up a granite dome in the morning, a swim and a rest in the afternoon.&lt;/p>&#xa;&lt;p>&lt;b>Day 4&lt;/b>&lt;/p>&#xa;&lt;p>A long descent through forest toward the rim of the valley. The last camp looks straight across at the great cliffs.&lt;/p>&#xa;&lt;p>&lt;b>Day 5&lt;/b>&lt;/p>&#xa;&lt;p>Down the trail beside two waterfalls, wet with spray, to the valley floor and a well-earned lunch.&lt;/p>"
                itinerary_x0040_ContentType="text/html"
                itinerary_x0040_LastModified="{Date}2020-11-05T13:18:58.027-08:00"
