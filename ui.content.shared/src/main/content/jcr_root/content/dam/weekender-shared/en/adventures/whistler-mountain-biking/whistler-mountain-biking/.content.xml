            <master
                jcr:mixinTypes="[cq:Taggable,dam:cfVariationNode]"
                jcr:primaryType="nt:unstructured"
                activity="Cycling"
                activity_x0040_LastModified="{Date}2020-10-15T13:10:23.790-07:00"
                adventureType="Overnight Trip"
                adventureType_x0040_LastModified="{Date}2020-10-15T13:10:23.789-07:00"
                description="&lt;h2>&lt;b>Two days on Whistler's trails&lt;/b>&lt;/h2>&#xa;&lt;p>Whistler is as well known among mountain bikers as among skiers. Hundreds of kilometres of trail run through the forest around the village, and in summer the ski lifts carry bikes. This weekend is for riders who are at ease on rough ground and want to go faster and more smoothly, with a coach who knows every root.&lt;/p>"
                description_x0040_ContentType="text/html"
                description_x0040_LastModified="{Date}2020-10-15T13:10:23.789-07:00"
                difficulty="Advanced"
                difficulty_x0040_LastModified="{Date}2020-10-15T13:10:23.791-07:00"
                gearList="&lt;p>The weather in the mountains changes quickly, so pack for sun and for rain.&lt;/p>&#xa;&lt;ul>&#xa;&lt;li>A full-suspension mountain bike (hire is available in the village)&lt;/li>&#xa;&lt;li>A full-face helmet for the bike park&lt;/li>&#xa;&lt;li>Knee pads and gloves&lt;/li>&#xa;&lt;li>Glasses or goggles&lt;/li>&#xa;&lt;li>A rain jacket&lt;/li>&#xa;&lt;li>A small pack with water and a spare tube&lt;/li>&#xa;&lt;/ul>"
                gearList_x0040_ContentType="text/html"
                gearList_x0040_LastModified="{Date}2020-10-15T13:10:23.793-07:00"
                groupSize="{Long}3"
                groupSize_x0040_LastModified="{Date}2022-05-27T14:51:23.811-07:00"
                itinerary="&lt;h2>&lt;b>Day 1: The valley trails&lt;/b>&lt;/h2>&#xa;&lt;p>We start on the network around the lake beside the village: narrow, twisting paths over roots and wooden bridges, with short climbs between them. The coach works with each rider on cornering and braking. After lunch we cross the valley to longer, rockier descents, and finish at a jetty for a swim.&lt;/p>&#xa;&lt;h2>&lt;b>Day 2: The bike park&lt;/b>&lt;/h2>&#xa;&lt;p>A day on the lifts. We begin on the wide, banked green and blue trails, repeating sections until they feel easy, and move on to steeper runs as the group wishes. Nobody is pushed, and the last run of the day is always the one you liked best.&lt;/p>"
                itinerary_x0040_ContentType="text/html"
